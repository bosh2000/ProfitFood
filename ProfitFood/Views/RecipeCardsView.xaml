<UserControl
    x:Class="ProfitFood.UI.Views.RecipeCardsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProfitFood.UI.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:RecipeCardsViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Cards.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Forms.xaml" />
                <ResourceDictionary Source="/Resource/Styles/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="24"
            FontWeight="SemiBold"
            Foreground="#102A43"
            Text="{Binding Title}" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Height="34"
                Padding="10,6"
                Style="{StaticResource AppTextBoxStyle}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="8,0,8,0"
                    Command="{Binding SearchCommand}"
                    Content="Найти"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="170"
                    Margin="0,0,8,0"
                    Command="{Binding CreateCommand}"
                    Content="Новая техкарта"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="110"
                    Command="{Binding RefreshCommand}"
                    Content="Обновить"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!--  Журнал техкарт  -->
            <DataGrid
                Grid.Column="0"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem}"
                Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding CardNumber}"
                        Header="Номер" />
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Name}"
                        Header="Наименование" />
                    <DataGridTextColumn
                        Width="0.8*"
                        Binding="{Binding VersionNumber}"
                        Header="Вер." />
                </DataGrid.Columns>
            </DataGrid>

            <!--  Карточка техкарты: шапка, версия, ингредиенты  -->
            <Border
                Grid.Column="2"
                Padding="16"
                Background="#F8FBFF"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#102A43"
                            Text="Карточка техкарты" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="#486581"
                                    Text="Номер" />
                                <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditModel.CardNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="#486581"
                                    Text="Блюдо" />
                                <ComboBox
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding DishOptions}"
                                    SelectedValue="{Binding EditModel.DishId}"
                                    SelectedValuePath="Id"
                                    Style="{StaticResource AppComboBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,8,0,6"
                            Foreground="#486581"
                            Text="Наименование" />
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditModel.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!--  Версия: даты, выход, единица, утверждение  -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock
                                Margin="0,0,0,6"
                                Foreground="#486581"
                                Text="Версия" />
                            <TextBlock Foreground="#102A43" Text="{Binding VersionNumber}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock
                                Margin="0,0,0,6"
                                Foreground="#486581"
                                Text="Действует с" />
                            <DatePicker SelectedDate="{Binding VersionDateFrom}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock
                                Margin="0,0,0,6"
                                Foreground="#486581"
                                Text="Действует по" />
                            <DatePicker SelectedDate="{Binding VersionDateTo}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="6">
                            <TextBlock
                                Margin="0,0,0,6"
                                Foreground="#486581"
                                Text="Выход" />
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding OutputQuantity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock
                                Margin="0,8,0,6"
                                Foreground="#486581"
                                Text="Единица выхода" />
                            <ComboBox
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding UnitOptions}"
                                SelectedValue="{Binding OutputUnitId}"
                                SelectedValuePath="Id"
                                Style="{StaticResource AppComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock
                                Margin="0,8,0,6"
                                Foreground="#486581"
                                Text="Описание версии" />
                            <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding VersionDescription, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <CheckBox
                            Grid.Row="1"
                            Grid.Column="4"
                            Margin="0,28,0,0"
                            Content="Версия утверждена"
                            IsChecked="{Binding IsApproved}" />
                    </Grid>

                    <!--  Ингредиенты версии  -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Ingredients}"
                            SelectedItem="{Binding SelectedIngredient}"
                            Style="{StaticResource AppDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="2.4*"
                                    Binding="{Binding ProductName}"
                                    Header="Продукт" />
                                <DataGridTextColumn
                                    Width="0.8*"
                                    Binding="{Binding UnitName}"
                                    Header="Ед." />
                                <DataGridTextColumn
                                    Width="0.9*"
                                    Binding="{Binding GrossQuantity}"
                                    Header="Брутто" />
                                <DataGridTextColumn
                                    Width="0.9*"
                                    Binding="{Binding NetQuantity}"
                                    Header="Нетто" />
                                <DataGridTextColumn
                                    Width="0.9*"
                                    Binding="{Binding LossPercent}"
                                    Header="Потери, %" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding ProductOptions}"
                                SelectedValue="{Binding NewIngredientProductId}"
                                SelectedValuePath="Id"
                                Style="{StaticResource AppComboBoxStyle}" />
                            <ComboBox
                                Grid.Column="2"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding UnitOptions}"
                                SelectedValue="{Binding NewIngredientUnitId}"
                                SelectedValuePath="Id"
                                Style="{StaticResource AppComboBoxStyle}" />
                            <TextBox
                                Grid.Column="4"
                                Style="{StaticResource AppTextBoxStyle}"
                                Text="{Binding NewGrossQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="6"
                                Style="{StaticResource AppTextBoxStyle}"
                                Text="{Binding NewNetQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="8"
                                Style="{StaticResource AppTextBoxStyle}"
                                Text="{Binding NewLossPercent, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel
                                Grid.Column="9"
                                Margin="8,0,0,0"
                                Orientation="Horizontal">
                                <Button
                                    Width="90"
                                    Margin="0,0,8,0"
                                    Command="{Binding AddIngredientCommand}"
                                    Content="Добавить"
                                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                                <Button
                                    Width="90"
                                    Command="{Binding RemoveIngredientCommand}"
                                    Content="Убрать"
                                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <!--  Выход блюда по возрастным группам  -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="0,0,0,6"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#334E68"
                                Text="Выход по возрастам" />

                            <DataGrid
                                Grid.Row="1"
                                MaxHeight="150"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding Outputs}"
                                SelectedItem="{Binding SelectedOutput}"
                                Style="{StaticResource AppDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="2*"
                                        Binding="{Binding AgeGroupName}"
                                        Header="Возрастная группа" />
                                    <DataGridTextColumn
                                        Width="1*"
                                        Binding="{Binding OutputQuantity}"
                                        Header="Выход" />
                                    <DataGridTextColumn
                                        Width="1*"
                                        Binding="{Binding UnitName}"
                                        Header="Ед." />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox
                                    Grid.Column="0"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding AgeGroupOptions}"
                                    SelectedValue="{Binding NewOutputAgeGroupId}"
                                    SelectedValuePath="Id"
                                    Style="{StaticResource AppComboBoxStyle}" />
                                <TextBox
                                    Grid.Column="2"
                                    Style="{StaticResource AppTextBoxStyle}"
                                    Text="{Binding NewOutputQuantity, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox
                                    Grid.Column="4"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding UnitOptions}"
                                    SelectedValue="{Binding NewOutputUnitId}"
                                    SelectedValuePath="Id"
                                    Style="{StaticResource AppComboBoxStyle}" />

                                <StackPanel
                                    Grid.Column="5"
                                    Margin="8,0,0,0"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="90"
                                        Margin="0,0,8,0"
                                        Command="{Binding AddOutputCommand}"
                                        Content="Добавить"
                                        Style="{StaticResource HoverPrimaryButtonStyle}" />
                                    <Button
                                        Width="90"
                                        Command="{Binding RemoveOutputCommand}"
                                        Content="Убрать"
                                        Style="{StaticResource HoverPrimaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <StackPanel
                        Grid.Row="3"
                        Margin="0,16,0,0"
                        Orientation="Horizontal">
                        <Button
                            Width="120"
                            Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"
                            Content="Сохранить"
                            Style="{StaticResource HoverPrimaryButtonStyle}" />
                        <Button
                            Width="110"
                            Command="{Binding DeleteCommand}"
                            Content="Удалить"
                            Style="{StaticResource HoverPrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            Foreground="#627D98"
            Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
