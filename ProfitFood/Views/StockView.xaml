<UserControl
    x:Class="ProfitFood.UI.Views.StockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProfitFood.UI.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:StockViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Cards.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Forms.xaml" />
                <ResourceDictionary Source="/Resource/Styles/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="24"
            FontWeight="SemiBold"
            Foreground="#102A43"
            Text="{Binding Title}" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Height="34"
                Padding="10,6"
                Style="{StaticResource AppTextBoxStyle}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="8,0,8,0"
                    Command="{Binding SearchCommand}"
                    Content="Найти"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding CreateCommand}"
                    Content="Добавить"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="110"
                    Command="{Binding RefreshCommand}"
                    Content="Обновить"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <DataGrid
                Grid.Column="0"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem}"
                Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="2.4*"
                        Binding="{Binding ProductName}"
                        Header="Продукт" />
                    <DataGridTextColumn
                        Width="1.4*"
                        Binding="{Binding StorageLocationName}"
                        Header="Склад" />
                    <DataGridTextColumn
                        Width="0.9*"
                        Binding="{Binding Quantity}"
                        Header="Остаток" />
                    <DataGridTextColumn
                        Width="0.8*"
                        Binding="{Binding UnitName}"
                        Header="Ед." />
                    <DataGridTextColumn
                        Width="0.9*"
                        Binding="{Binding MinStock}"
                        Header="Минимум" />
                    <DataGridCheckBoxColumn
                        Width="0.9*"
                        Binding="{Binding IsDeficit}"
                        Header="Дефицит" />
                </DataGrid.Columns>
            </DataGrid>

            <!--  Карточка записи: внесение нового остатка или изменение существующего  -->
            <Border
                Grid.Column="2"
                Padding="16"
                Background="#F8FBFF"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#102A43"
                            Text="Карточка остатка" />

                        <TextBlock
                            Margin="0,16,0,6"
                            Foreground="#486581"
                            Text="Продукт" />
                        <ComboBox
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding ProductOptions}"
                            SelectedValue="{Binding EditModel.ProductId}"
                            SelectedValuePath="Id"
                            Style="{StaticResource AppComboBoxStyle}" />

                        <TextBlock
                            Margin="0,12,0,6"
                            Foreground="#486581"
                            Text="Склад" />
                        <ComboBox
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding StorageLocationOptions}"
                            SelectedValue="{Binding EditModel.StorageLocationId}"
                            SelectedValuePath="Id"
                            Style="{StaticResource AppComboBoxStyle}" />

                        <TextBlock
                            Margin="0,12,0,6"
                            Foreground="#486581"
                            Text="Единица измерения" />
                        <ComboBox
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding UnitOptions}"
                            SelectedValue="{Binding EditModel.UnitId}"
                            SelectedValuePath="Id"
                            Style="{StaticResource AppComboBoxStyle}" />

                        <TextBlock
                            Margin="0,12,0,6"
                            Foreground="#486581"
                            Text="Количество" />
                        <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditModel.Quantity, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                            <Button
                                Width="120"
                                Margin="0,0,8,0"
                                Command="{Binding SaveCommand}"
                                Content="Сохранить"
                                Style="{StaticResource HoverPrimaryButtonStyle}" />
                            <Button
                                Width="120"
                                Command="{Binding CancelCommand}"
                                Content="Отмена"
                                Style="{StaticResource HoverPrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            Foreground="#627D98"
            Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
