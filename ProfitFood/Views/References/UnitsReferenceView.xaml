<UserControl x:Class="ProfitFood.Views.References.UnitsReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Title}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#102A43" />
                <TextBlock Margin="0,6,0,0"
                           Text="Базовые единицы измерения и коэффициенты пересчета"
                           FontSize="13"
                           Foreground="#627D98" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Добавить"
                        Width="110"
                        Margin="0,0,8,0"
                        Command="{Binding CreateCommand}" />
                <Button Content="Изменить"
                        Width="110"
                        Margin="0,0,8,0"
                        Command="{Binding EditCommand}" />
                <Button Content="Удалить"
                        Width="110"
                        Margin="0,0,8,0"
                        Command="{Binding DeleteCommand}" />
                <Button Content="Обновить"
                        Width="110"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Height="34"
                     Padding="10,6"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    Width="100"
                    Margin="8,0,0,0"
                    Content="Найти"
                    Command="{Binding SearchCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      AutoGenerateColumns="False"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Кратко" Binding="{Binding ShortName}" Width="1*" />
                    <DataGridTextColumn Header="Тип" Binding="{Binding UnitTypeName}" Width="1*" />
                    <DataGridCheckBoxColumn Header="Базовая" Binding="{Binding IsBase}" Width="0.8*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="#F8FBFF"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Карточка записи"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#102A43" />

                    <TextBlock Margin="0,16,0,6" Text="Наименование" Foreground="#486581" />
                    <TextBox Text="{Binding EditModel.Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,12,0,6" Text="Краткое имя" Foreground="#486581" />
                    <TextBox Text="{Binding EditModel.ShortName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,12,0,6" Text="Тип единицы" Foreground="#486581" />
                    <ComboBox ItemsSource="{Binding UnitTypes}"
                              SelectedItem="{Binding EditModel.UnitType}" />

                    <CheckBox Margin="0,12,0,0"
                              Content="Базовая единица"
                              IsChecked="{Binding EditModel.IsBase}" />

                    <TextBlock Margin="0,12,0,6" Text="Коэффициент" Foreground="#486581" />
                    <TextBox Text="{Binding EditModel.BaseFactor, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Сохранить"
                                Width="120"
                                Margin="0,0,8,0"
                                Command="{Binding SaveCommand}" />
                        <Button Content="Отмена"
                                Width="120"
                                Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="#627D98"
                   Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>