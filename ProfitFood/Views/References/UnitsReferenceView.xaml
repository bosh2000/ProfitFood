<UserControl
    x:Class="ProfitFood.UI.Views.References.UnitsReferenceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProfitFood.UI.ViewModels.Reference.Units"
    d:DataContext="{d:DesignInstance Type=vm:UnitsReferenceViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Cards.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Forms.xaml" />
                <ResourceDictionary Source="/Resource/Styles/DataGrid.xaml" />
                <ResourceDictionary Source="/Resource/Styles/ListBox.xaml" />
                <ResourceDictionary Source="/Resource/Templates/ReferenceTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#102A43"
                    Text="{Binding Title}" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="13"
                    Foreground="#627D98"
                    Text="Базовые единицы измерения и коэффициенты пересчета" />
            </StackPanel>

            <!--           <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
            </StackPanel>-->
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Height="34"
                Padding="10,6"
                Style="{StaticResource AppTextBoxStyle}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="8,0,8,0"
                    Command="{Binding SearchCommand}"
                    Content="Найти"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding CreateCommand}"
                    Content="Добавить"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding DeleteCommand}"
                    Content="Удалить"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="110"
                    Command="{Binding RefreshCommand}"
                    Content="Обновить"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <DataGrid
                Grid.Column="0"
                AutoGenerateColumns="False"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem}"
                Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Name}"
                        Header="Наименование" />
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding ShortName}"
                        Header="Кратко" />
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding UnitTypeName}"
                        Header="Тип" />
                    <DataGridCheckBoxColumn
                        Width="0.8*"
                        Binding="{Binding IsBase}"
                        Header="Базовая" />
                </DataGrid.Columns>
            </DataGrid>

            <Border
                Grid.Column="2"
                Padding="16"
                Background="#F8FBFF"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#102A43"
                        Text="Карточка записи" />

                    <TextBlock
                        Margin="0,16,0,6"
                        Foreground="#486581"
                        Text="Наименование" />
                    <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditModel.Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,12,0,6"
                        Foreground="#486581"
                        Text="Краткое имя" />
                    <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditModel.ShortName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,12,0,6"
                        Foreground="#486581"
                        Text="Тип единицы" />
                    <ComboBox
                        ItemsSource="{Binding UnitTypes}"
                        SelectedItem="{Binding EditModel.UnitType}"
                        Style="{StaticResource AppComboBoxStyle}" />

                    <CheckBox
                        Margin="0,12,0,0"
                        Content="Базовая единица"
                        IsChecked="{Binding EditModel.IsBase}" />

                    <TextBlock
                        Margin="0,12,0,6"
                        Foreground="#486581"
                        Text="Коэффициент" />
                    <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditModel.BaseFactor, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Button
                            Width="120"
                            Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"
                            Content="Сохранить"
                            Style="{StaticResource HoverPrimaryButtonStyle}" />
                        <Button
                            Width="120"
                            Command="{Binding CancelCommand}"
                            Content="Отмена"
                            Style="{StaticResource HoverPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            Foreground="#627D98"
            Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>