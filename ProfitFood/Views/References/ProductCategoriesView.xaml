<UserControl
    x:Class="ProfitFood.UI.Views.References.ProductCategoriesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ProfitFood.UI.Views.References"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Cards.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Forms.xaml" />
                <ResourceDictionary Source="/Resource/Styles/DataGrid.xaml" />
                <ResourceDictionary Source="/Resource/Styles/ListBox.xaml" />
                <ResourceDictionary Source="/Resource/Templates/ReferenceTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Категории продуктов" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource MutedTextStyle}"
                    Text="Иерархический справочник группировки продуктов" />
            </StackPanel>

            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    Width="150"
                    Margin="0,0,8,0"
                    Command="{Binding AddRootCommand}"
                    Content="Добавить корневую"
                    Style="{StaticResource PrimaryButtonStyle}" />

                <Button
                    Width="160"
                    Margin="0,0,8,0"
                    Command="{Binding AddChildCommand}"
                    Content="Добавить дочернюю"
                    Style="{StaticResource SecondaryButtonStyle}" />

                <Button
                    Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding DeleteCommand}"
                    Content="Удалить"
                    Style="{StaticResource SecondaryButtonStyle}" />

                <Button
                    Width="110"
                    Command="{Binding RefreshCommand}"
                    Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCardBorderStyle}">
                <TreeView ItemsSource="{Binding Categories}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelCardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Карточка категории" />

                    <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Наименование" />
                    <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditModel.Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Родительская категория" />
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding ParentCategoryOptions}"
                        SelectedValue="{Binding EditModel.ParentCategoryId}"
                        SelectedValuePath="Id"
                        Style="{StaticResource AppComboBoxStyle}" />

                    <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Порядок сортировки" />
                    <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding EditModel.SortOrder, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Button
                            Width="120"
                            Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"
                            Content="Сохранить"
                            Style="{StaticResource PrimaryButtonStyle}" />

                        <Button
                            Width="120"
                            Command="{Binding CancelCommand}"
                            Content="Отмена"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Margin="0,12,0,0"
            Style="{StaticResource MutedTextStyle}"
            Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>