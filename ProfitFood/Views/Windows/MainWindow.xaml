<Window
    x:Class="ProfitFood.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:ProfitFood.UI.Views"
    xmlns:vm="clr-namespace:ProfitFood.UI.ViewModels"
    xmlns:vmDialyMenuEditor="clr-namespace:ProfitFood.UI.ViewModels.DailyMenuEditorViewModels"
    xmlns:vmDashboardViewModel="clr-namespace:ProfitFood.UI.ViewModels.DashBoardViewModels"
    xmlns:vmReferenceViewModel="clr-namespace:ProfitFood.UI.ViewModels.Reference"
    Title="ProfitFood"
    Width="1400"
    Height="900"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  Какой View показывать для какой ViewModel  -->
        <DataTemplate DataType="{x:Type vmDashboardViewModel:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmDialyMenuEditor:DailyMenuEditorViewModel}">
            <views:DailyMenuEditorView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RecipeCardsViewModel}">
            <views:RecipeCardsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StockViewModel}">
            <views:StockView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <views:DocumentsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmReferenceViewModel:ReferencesViewModel}">
            <views:ReferencesView />
        </DataTemplate>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="#2F6FED" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2F6FED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                         Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="{TemplateBinding BorderThickness}"
                         CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334E68" />
            <Setter Property="BorderBrush" Value="#BCCCDC" />
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Верхняя панель  -->
        <Border
            Grid.Row="0"
            Background="White"
            BorderBrush="#D9E2EC"
            BorderThickness="0,0,0,1">
            <DockPanel Margin="16,12">
                <TextBlock
                    DockPanel.Dock="Left"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="#102A43"
                    Text="ProfitFood — учет питания МДОУ" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding OpenDailyMenuEditorCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Создать меню" />
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding OpenDailyMenusCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Открыть список меню" />
                    <Button
                        Command="{Binding OpenDocumentsCommand}"
                        Content="Документы"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Основная область  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Боковое меню  -->
            <Border
                Grid.Column="0"
                Background="White"
                BorderBrush="#D9E2EC"
                BorderThickness="0,0,1,0">
                <StackPanel Margin="12">
                    <TextBlock
                        Margin="8,8,8,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#334E68"
                        Text="Разделы" />

                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding OpenDashboardCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Главная" />

                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding OpenDailyMenusCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Меню" />

                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding OpenRecipeCardsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Техкарты" />

                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding OpenStockCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Склад" />

                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding OpenDocumentsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Документы" />

                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding OpenReferencesCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Справочники" />
                </StackPanel>
            </Border>

            <!--  Здесь будет меняться представление  -->
            <ContentControl
                Grid.Column="1"
                Margin="12"
                Content="{Binding CurrentViewModel}" />
        </Grid>

        <!--  Строка состояния  -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>