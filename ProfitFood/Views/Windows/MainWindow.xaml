<Window
    x:Class="ProfitFood.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:ProfitFood.UI.Views"
    xmlns:vm="clr-namespace:ProfitFood.UI.ViewModels"
    xmlns:vmDialyMenuEditor="clr-namespace:ProfitFood.UI.ViewModels.DailyMenuEditorViewModels"
    xmlns:vmDashboardViewModel="clr-namespace:ProfitFood.UI.ViewModels.DashBoardViewModels"
    xmlns:vmReferenceViewModel="clr-namespace:ProfitFood.UI.ViewModels.Reference"
    Title="ProfitFood"
    Width="1400"
    Height="900"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Resource/Styles/ListBox.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Какой View показывать для какой ViewModel  -->
            <DataTemplate DataType="{x:Type vmDashboardViewModel:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DailyMenuListViewModel}">
                <views:DailyMenuListView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmDialyMenuEditor:DailyMenuEditorViewModel}">
                <views:DailyMenuEditorView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RecipeCardsViewModel}">
                <views:RecipeCardsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:StockViewModel}">
                <views:StockView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
                <views:DocumentsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmReferenceViewModel:ReferencesViewModel}">
                <views:ReferencesView />
            </DataTemplate>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Background" Value="#2F6FED" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#2F6FED" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.92" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.82" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="#334E68" />
                <Setter Property="BorderBrush" Value="#BCCCDC" />
            </Style>

            <!--  Ярлык вкладки: заголовок и кнопка закрытия  -->
            <DataTemplate x:Key="TabHeaderTemplate" DataType="{x:Type vm:TabItemViewModel}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding Header}" />
                    <Button
                        Margin="8,0,0,0"
                        Padding="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CloseCommand}"
                        Content="✕"
                        Cursor="Hand"
                        FontSize="11"
                        ToolTip="Закрыть вкладку" />
                </StackPanel>
            </DataTemplate>

            <!--  Контейнер вкладки: в содержимое попадает страница раздела, а не сама обёртка TabItemViewModel  -->
            <Style x:Key="TabItemContainerStyle" TargetType="TabItem">
                <Setter Property="Content" Value="{Binding Content}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#FFF5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Верхняя панель  -->
        <Border
            Grid.Row="0"
            Background="White"
            BorderBrush="#D9E2EC"
            BorderThickness="0,0,0,1">
            <DockPanel Margin="16,12">
                <TextBlock
                    DockPanel.Dock="Left"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="#102A43"
                    Text="ProfitFood — учет питания МДОУ" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding CreateMenuCommand}"
                        Content="Создать меню"
                        Style="{StaticResource PrimaryButtonStyle}" />
                    <Button
                        Command="{Binding SelectedTab.CloseCommand}"
                        Content="Закрыть вкладку"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Основная область: меню разделов и вкладки  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="White"
                BorderBrush="#D9E2EC"
                BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="8,8,8,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#334E68"
                        Text="Разделы" />

                    <ListBox
                        Grid.Row="1"
                        DisplayMemberPath="Title"
                        ItemContainerStyle="{StaticResource ReferenceSectionListBoxItemStyle}"
                        ItemsSource="{Binding Sections}"
                        SelectedItem="{Binding SelectedSection}"
                        Style="{StaticResource ReferenceSectionListBoxStyle}" />
                </Grid>
            </Border>

            <TabControl
                Grid.Column="1"
                Margin="12"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource TabItemContainerStyle}"
                ItemTemplate="{StaticResource TabHeaderTemplate}"
                ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding SelectedTab}" />
        </Grid>

        <!--  Строка состояния  -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
