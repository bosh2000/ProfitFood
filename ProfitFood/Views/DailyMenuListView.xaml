<UserControl
    x:Class="ProfitFood.UI.Views.DailyMenuListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProfitFood.UI.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DailyMenuListViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Cards.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Forms.xaml" />
                <ResourceDictionary Source="/Resource/Styles/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="24"
            FontWeight="SemiBold"
            Foreground="#102A43"
            Text="{Binding Title}" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Height="34"
                Padding="10,6"
                Style="{StaticResource AppTextBoxStyle}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="8,0,8,0"
                    Command="{Binding SearchCommand}"
                    Content="Найти"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding CreateCommand}"
                    Content="Добавить"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding DeleteCommand}"
                    Content="Удалить"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="110"
                    Command="{Binding RefreshCommand}"
                    Content="Обновить"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <DataGrid
                Grid.Column="0"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem}"
                Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding MenuDate, StringFormat=dd.MM.yyyy}"
                        Header="Дата" />
                    <DataGridTextColumn
                        Width="1.2*"
                        Binding="{Binding SeasonName}"
                        Header="Сезон" />
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding StatusName}"
                        Header="Статус" />
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Notes}"
                        Header="Примечание" />
                </DataGrid.Columns>
            </DataGrid>

            <!--  Карточка записи: создание новой или изменение выбранной  -->
            <Border
                Grid.Column="2"
                Padding="16"
                Background="#F8FBFF"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#102A43"
                            Text="Карточка меню" />

                        <TextBlock
                            Margin="0,16,0,6"
                            Foreground="#486581"
                            Text="Дата меню" />
                        <DatePicker SelectedDate="{Binding EditDate}" />

                        <TextBlock
                            Margin="0,12,0,6"
                            Foreground="#486581"
                            Text="Сезон" />
                        <ComboBox
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding SeasonOptions}"
                            SelectedValue="{Binding EditModel.SeasonId}"
                            SelectedValuePath="Id"
                            Style="{StaticResource AppComboBoxStyle}" />

                        <TextBlock
                            Margin="0,12,0,6"
                            Foreground="#486581"
                            Text="Примечание" />
                        <TextBox
                            Height="80"
                            AcceptsReturn="True"
                            Style="{StaticResource AppTextBoxStyle}"
                            Text="{Binding EditModel.Notes, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,12,0,0"
                            Foreground="#627D98"
                            Text="{Binding EditModel.StatusName, StringFormat=Статус: {0}}" />

                        <!--  Посещаемость по группам: план берётся из справочника, факт заполняется вручную  -->
                        <TextBlock
                            Margin="0,16,0,6"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#334E68"
                            Text="Посещаемость" />
                        <DataGrid
                            MaxHeight="180"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            ItemsSource="{Binding AttendanceRows}"
                            Style="{StaticResource AppDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="2*"
                                    Binding="{Binding ChildGroupName}"
                                    Header="Группа"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="1*"
                                    Binding="{Binding PlannedCount}"
                                    Header="План"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="1*"
                                    Binding="{Binding ActualCount, UpdateSourceTrigger=PropertyChanged}"
                                    Header="Факт" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button
                            Width="200"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding SaveAttendanceCommand}"
                            Content="Сохранить посещаемость"
                            Style="{StaticResource HoverPrimaryButtonStyle}" />

                        <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                            <Button
                                Width="120"
                                Margin="0,0,8,0"
                                Command="{Binding SaveCommand}"
                                Content="Сохранить"
                                Style="{StaticResource HoverPrimaryButtonStyle}" />
                            <Button
                                Width="120"
                                Command="{Binding CancelCommand}"
                                Content="Отмена"
                                Style="{StaticResource HoverPrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            Foreground="#627D98"
            Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
