<UserControl
    x:Class="ProfitFood.UI.Views.MenuRequirementsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProfitFood.UI.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MenuRequirementsViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Cards.xaml" />
                <ResourceDictionary Source="/Resource/Styles/Forms.xaml" />
                <ResourceDictionary Source="/Resource/Styles/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="24"
            FontWeight="SemiBold"
            Foreground="#102A43"
            Text="{Binding Title}" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="#486581"
                Text="Меню для расчёта:" />
            <ComboBox
                Grid.Column="1"
                Margin="8,0,0,0"
                DisplayMemberPath="MenuDate"
                ItemsSource="{Binding MenuOptions}"
                SelectedItem="{Binding SelectedMenuOption}"
                Style="{StaticResource AppComboBoxStyle}" />

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="170"
                    Margin="8,0,8,0"
                    Command="{Binding CalculateCommand}"
                    Content="Рассчитать по меню"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
                <Button
                    Width="110"
                    Command="{Binding RefreshCommand}"
                    Content="Обновить"
                    Style="{StaticResource HoverPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.9*" />
            </Grid.ColumnDefinitions>

            <DataGrid
                Grid.Column="0"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem}"
                Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="1.2*"
                        Binding="{Binding Number}"
                        Header="Номер" />
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding RequirementDate, StringFormat=dd.MM.yyyy}"
                        Header="Дата" />
                    <DataGridTextColumn
                        Width="0.8*"
                        Binding="{Binding TotalChildrenCount}"
                        Header="Детей" />
                    <DataGridTextColumn
                        Width="1.1*"
                        Binding="{Binding StatusName}"
                        Header="Статус" />
                </DataGrid.Columns>
            </DataGrid>

            <Border
                Grid.Column="2"
                Padding="16"
                Background="#F8FBFF"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#102A43"
                            Text="Карточка требования" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#486581" Text="Номер" />
                                <TextBlock Foreground="#102A43" Text="{Binding EditModel.Number}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="#486581" Text="Статус" />
                                <TextBlock Foreground="#102A43" Text="{Binding EditModel.StatusName}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#486581" Text="Дата" />
                                <TextBlock Foreground="#102A43" Text="{Binding EditModel.RequirementDate, StringFormat=dd.MM.yyyy}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="#486581" Text="Склад" />
                                <TextBlock Foreground="#102A43" Text="{Binding EditModel.StorageLocationName}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="#627D98"
                            Text="{Binding EditModel.TotalChildrenCount, StringFormat=Детей: {0}}" />
                    </StackPanel>

                    <DataGrid
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding DocumentItems}"
                        Style="{StaticResource AppDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="2.4*"
                                Binding="{Binding ProductName}"
                                Header="Продукт" />
                            <DataGridTextColumn
                                Width="0.9*"
                                Binding="{Binding UnitName}"
                                Header="Ед." />
                            <DataGridTextColumn
                                Width="1*"
                                Binding="{Binding Quantity}"
                                Header="Количество" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,16,0,0"
                        Orientation="Horizontal">
                        <Button
                            Width="120"
                            Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"
                            Content="Сохранить"
                            Style="{StaticResource HoverPrimaryButtonStyle}" />
                        <Button
                            Width="120"
                            Command="{Binding DeleteCommand}"
                            Content="Удалить"
                            Style="{StaticResource HoverPrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            Foreground="#627D98"
            Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
