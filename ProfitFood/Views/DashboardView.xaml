<UserControl
    x:Class="ProfitFood.UI.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProfitFood.UI.ViewModels.DashBoardViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel,IsDesignTimeCreatable=True}"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFF5F7FA" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="White" />
        <SolidColorBrush x:Key="BorderBrushLight" Color="#D9E2EC" />
        <SolidColorBrush x:Key="ForegroundPrimary" Color="#102A43" />
        <SolidColorBrush x:Key="ForegroundSecondary" Color="#486581" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#137333" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B26A00" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="#2F6FED" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2F6FED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="SecondaryButtonStyle"
            BasedOn="{StaticResource PrimaryButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334E68" />
            <Setter Property="BorderBrush" Value="#BCCCDC" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FBFF" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EDF5" />
            <Setter Property="VerticalGridLinesBrush" Value="#F0F4F8" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F4F8" />
            <Setter Property="Foreground" Value="#243B53" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#102A43" />
            <Setter Property="BorderBrush" Value="#EEF2F6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFF" />
                    <Setter Property="Foreground" Value="#102A43" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF6FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="16,16,16,8"
            Style="{StaticResource CardBorderStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ForegroundPrimary}"
                        Text="Главная панель" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        Foreground="#627D98"
                        Text="Оперативное состояние питания на сегодня" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="120"
                        Margin="0,0,8,0"
                        Command="{Binding CreateMenuCommand}"
                        Content="Создать меню"
                        Style="{StaticResource PrimaryButtonStyle}" />
                    <Button
                        Width="120"
                        Margin="0,0,8,0"
                        Command="{Binding OpenTodayMenuCommand}"
                        Content="Открыть меню"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Width="150"
                        Command="{Binding PrintRequirementCommand}"
                        Content="Печать формы 299"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  KPI  -->
        <Grid Grid.Row="1" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,8,0"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource ForegroundSecondary}" Text="Дата" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource ForegroundPrimary}"
                        Text="{Binding TodayDateText}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Margin="0,0,8,0"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource ForegroundSecondary}" Text="Детей на питании" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource ForegroundPrimary}"
                        Text="{Binding TotalChildren}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Margin="0,0,8,0"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource ForegroundSecondary}" Text="Блюд в меню" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource ForegroundPrimary}"
                        Text="{Binding DishCount}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource ForegroundSecondary}" Text="Статус меню" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{Binding MenuStatusBrush}"
                        Text="{Binding MenuStatus}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Main content  -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="2.2*" />
            </Grid.ColumnDefinitions>

            <!--  Quick actions  -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,8,8"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ForegroundPrimary}"
                        Text="Быстрые действия" />

                    <Button
                        Margin="0,16,0,8"
                        Command="{Binding CreateMenuCommand}"
                        Content="Создать меню на сегодня"
                        Style="{StaticResource PrimaryButtonStyle}" />
                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding OpenTodayMenuCommand}"
                        Content="Открыть меню"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding CalculateProductsCommand}"
                        Content="Рассчитать продукты"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding CreateRequirementCommand}"
                        Content="Создать меню-требование"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Command="{Binding PrintRequirementCommand}"
                        Content="Печать формы 299"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Border>

            <!--  Menu today  -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,8"
                Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock
                            DockPanel.Dock="Left"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ForegroundPrimary}"
                            Text="Меню на сегодня" />
                        <Button
                            Command="{Binding OpenTodayMenuCommand}"
                            Content="Открыть меню"
                            DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </DockPanel>

                    <DataGrid
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding TodayMenuItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="1.3*"
                                Binding="{Binding MealTypeName}"
                                Header="Прием пищи"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="2.2*"
                                Binding="{Binding DishName}"
                                Header="Блюдо"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="1*"
                                Binding="{Binding RecipeCardNumber}"
                                Header="Техкарта"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="0.9*"
                                Binding="{Binding OutputText}"
                                Header="Выход"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!--  Warnings  -->
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,8,0"
                Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ForegroundPrimary}"
                        Text="Контроль" />

                    <ItemsControl
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    Background="#FFF4E5"
                                    BorderBrush="#F0B429"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <TextBlock
                                        Foreground="#8D2B0B"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!--  Critical stock + last docs  -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ForegroundPrimary}"
                            Text="Критические остатки" />

                        <DataGrid
                            Grid.Row="1"
                            Margin="0,16,0,0"
                            AutoGenerateColumns="False"
                            ItemsSource="{Binding CriticalStockProducts}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="1.8*"
                                    Binding="{Binding ProductName}"
                                    Header="Продукт"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="1*"
                                    Binding="{Binding StockText}"
                                    Header="Остаток"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="1*"
                                    Binding="{Binding MinStockText}"
                                    Header="Мин."
                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ForegroundPrimary}"
                            Text="Последние документы" />

                        <DataGrid
                            Grid.Row="1"
                            Margin="0,16,0,0"
                            AutoGenerateColumns="False"
                            ItemsSource="{Binding LastDocuments}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="2*"
                                    Binding="{Binding DocumentName}"
                                    Header="Документ"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="1*"
                                    Binding="{Binding DateText}"
                                    Header="Дата"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="1.2*"
                                    Binding="{Binding StatusName}"
                                    Header="Статус"
                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  Status bar  -->
        <StatusBar Grid.Row="3" Margin="16,0,16,16">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>